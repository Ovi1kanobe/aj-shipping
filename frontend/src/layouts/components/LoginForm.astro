---
// LoginForm.astro - Client-side form component for authentication
---

<form id="loginForm" class="space-y-4">
  <div>
    <label for="email" class="block text-sm font-medium text-dark dark:text-darkmode-dark mb-2">
      Email Address
    </label>
    <input 
      type="email" 
      id="email" 
      name="email" 
      required
      class="w-full rounded-lg border border-border bg-body px-4 py-3 text-dark placeholder:text-dark/60 focus:border-primary focus:ring-0 dark:border-darkmode-border dark:bg-darkmode-body dark:text-darkmode-dark dark:placeholder:text-darkmode-dark/60"
      placeholder="Enter your email"
    />
  </div>

  <div>
    <label for="password" class="block text-sm font-medium text-dark dark:text-darkmode-dark mb-2">
      Password
    </label>
    <input 
      type="password" 
      id="password" 
      name="password" 
      required
      class="w-full rounded-lg border border-border bg-body px-4 py-3 text-dark placeholder:text-dark/60 focus:border-primary focus:ring-0 dark:border-darkmode-border dark:bg-darkmode-body dark:text-darkmode-dark dark:placeholder:text-darkmode-dark/60"
      placeholder="Enter your password"
    />
  </div>

  <div class="flex items-center justify-between">
    <label class="flex items-center">
      <input type="checkbox" class="rounded border-border text-primary focus:ring-primary" />
      <span class="ml-2 text-sm text-dark dark:text-darkmode-dark">Remember me</span>
    </label>
    <a href="/forgot-password" class="text-sm text-primary hover:underline">
      Forgot password?
    </a>
  </div>

  <button 
    type="submit" 
    class="w-full rounded-lg bg-primary px-6 py-3 text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
    id="loginButton"
  >
    <span id="loginText">Sign In</span>
    <span id="loginLoader" class="hidden">Signing in...</span>
  </button>

  <!-- Error message display -->
  <div id="errorMessage" class="hidden rounded-lg bg-red-50 border border-red-200 p-4 text-red-800">
  </div>

  <!-- Success message display -->
  <div id="successMessage" class="hidden rounded-lg bg-green-50 border border-green-200 p-4 text-green-800">
  </div>
</form>

<script>
  import { login } from '@/lib/utils/pocketbase';

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const loginButton = document.getElementById('loginButton') as HTMLButtonElement;
  const loginText = document.getElementById('loginText') as HTMLSpanElement;
  const loginLoader = document.getElementById('loginLoader') as HTMLSpanElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLDivElement;
  const successMessage = document.getElementById('successMessage') as HTMLDivElement;

  function showError(message: string) {
    errorMessage.textContent = message;
    errorMessage.classList.remove('hidden');
    successMessage.classList.add('hidden');
  }

  function showSuccess(message: string) {
    successMessage.textContent = message;
    successMessage.classList.remove('hidden');
    errorMessage.classList.add('hidden');
  }

  function hideMessages() {
    errorMessage.classList.add('hidden');
    successMessage.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    loginButton.disabled = loading;
    if (loading) {
      loginText.classList.add('hidden');
      loginLoader.classList.remove('hidden');
    } else {
      loginText.classList.remove('hidden');
      loginLoader.classList.add('hidden');
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMessages();
    setLoading(true);

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    try {
      const result = await login(email, password);
      
      if (result.success) {
        showSuccess('Login successful! Redirecting...');
        // Redirect to dashboard or home page after successful login
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 1500);
      } else {
        showError('Invalid email or password. Please try again.');
      }
    } catch (error) {
      showError('An error occurred during login. Please try again.');
      console.error('Login error:', error);
    } finally {
      setLoading(false);
    }
  });
</script>