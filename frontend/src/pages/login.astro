---
import Base from "@/layouts/Base.astro";
import LoginForm from "@/layouts/components/LoginForm.astro";

const meta_title = "Login - Crev Shipping";
const description = "Login to your Crev Shipping account to manage your shipments and track packages.";
---

<Base meta_title={meta_title} description={description}>
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-5 md:col-6">
          <div class="rounded-lg bg-theme-light p-8 shadow-lg dark:bg-darkmode-theme-light">
            <div class="text-center mb-6">
              <h1 class="mb-4 text-h3">Welcome Back</h1>
              <p class="text-dark dark:text-darkmode-dark">
                Sign in to your Crev Shipping account
              </p>
            </div>
            <LoginForm />
            
            <div class="mt-6 text-center">
              <p class="text-sm text-dark dark:text-darkmode-dark">
                Don't have an account? 
                <a href="/register" class="text-primary hover:underline font-medium">
                  Create one here
                </a>
              </p>
            </div>
            
            <div class="mt-4 text-center">
              <a href="/" class="text-sm text-dark hover:text-primary dark:text-darkmode-dark">
                ← Back to Homepage
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>