---
import Base from "@/layouts/Base.astro";

const meta_title = "Dashboard - Crev Shipping";
const description = "Manage your shipments and track packages with Crev Shipping.";
---

<Base meta_title={meta_title} description={description}>
  <!-- Loading Screen -->
  <div id="loadingScreen" class="section flex items-center justify-center min-h-screen">
    <div class="text-center">
      <div class="w-16 h-16 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
      <p class="text-dark dark:text-darkmode-dark">Loading your dashboard...</p>
    </div>
  </div>

  <!-- Regular User Dashboard -->
  <div id="userDashboard" class="hidden">
    <section class="section">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="mb-8 flex justify-between items-center">
              <div>
                <h1 class="mb-4 text-h2">My Shipments</h1>
                <p class="text-dark dark:text-darkmode-dark">
                  View and manage your shipping quote requests.
                </p>
              </div>
              <div class="flex gap-4">
                <a href="/quote" class="rounded bg-primary px-6 py-3 text-white hover:bg-primary/90">
                  New Quote Request
                </a>
                <button 
                  id="logoutButton"
                  class="rounded bg-red-600 px-4 py-3 text-white hover:bg-red-700"
                >
                  Logout
                </button>
              </div>
            </div>

            <!-- User Stats -->
            <div class="grid gap-6 md:grid-cols-3 mb-8">
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h5 text-primary">Total Requests</h3>
                <p class="text-3xl font-bold" id="totalRequests">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h5 text-green-600">Completed</h3>
                <p class="text-3xl font-bold text-green-600" id="completedRequests">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h5 text-orange-600">Pending</h3>
                <p class="text-3xl font-bold text-orange-600" id="pendingRequests">-</p>
              </div>
            </div>

            <!-- Quote Requests Table -->
            <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
              <h3 class="mb-4 text-h5">Your Quote Requests</h3>
              <div id="quoteRequestsTable">
                <p class="text-center text-dark dark:text-darkmode-dark py-8">Loading your quote requests...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Reseller Dashboard -->
  <div id="resellerDashboard" class="hidden">
    <section class="section">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="mb-8 flex justify-between items-center">
              <div>
                <h1 class="mb-4 text-h2">Reseller Dashboard</h1>
                <p class="text-dark dark:text-darkmode-dark">
                  Manage package acceptance and view your business statistics.
                </p>
              </div>
              <div class="flex gap-4">
                <button 
                  id="acceptPackageBtn"
                  class="rounded bg-primary px-6 py-3 text-white hover:bg-primary/90"
                >
                  Accept Package
                </button>
                <button 
                  id="resellerLogoutButton"
                  class="rounded bg-red-600 px-4 py-3 text-white hover:bg-red-700"
                >
                  Logout
                </button>
              </div>
            </div>

            <!-- Reseller Stats Overview -->
            <div class="grid gap-6 md:grid-cols-4 mb-8">
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-primary">Packages Accepted Today</h3>
                <p class="text-3xl font-bold" id="todayPackages">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-green-600">This Month</h3>
                <p class="text-3xl font-bold text-green-600" id="monthlyPackages">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-blue-600">Total Revenue</h3>
                <p class="text-3xl font-bold text-blue-600" id="totalRevenue">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-orange-600">Pending Quotes</h3>
                <p class="text-3xl font-bold text-orange-600" id="pendingQuotes">-</p>
              </div>
            </div>

            <!-- Charts and Analytics -->
            <div class="grid gap-6 lg:grid-cols-2 mb-8">
              <!-- Monthly Package Acceptance Chart -->
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-4 text-h5">Monthly Package Volume</h3>
                <div id="monthlyChart" class="h-64 flex items-center justify-center">
                  <div class="text-center">
                    <div class="w-16 h-16 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p class="text-dark dark:text-darkmode-dark">Loading chart...</p>
                  </div>
                </div>
              </div>

              <!-- Revenue Chart -->
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-4 text-h5">Revenue Trends</h3>
                <div id="revenueChart" class="h-64 flex items-center justify-center">
                  <div class="text-center">
                    <div class="w-16 h-16 border-4 border-green-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p class="text-dark dark:text-darkmode-dark">Loading chart...</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Recent Package Acceptances -->
            <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
              <h3 class="mb-4 text-h5">Recent Package Acceptances</h3>
              <div id="recentPackages">
                <p class="text-center text-dark dark:text-darkmode-dark py-8">Loading recent packages...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Manager Dashboard -->
  <div id="managerDashboard" class="hidden">
    <section class="section">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="mb-8 flex justify-between items-center">
              <div>
                <h1 class="mb-4 text-h2">Manager Dashboard</h1>
                <p class="text-dark dark:text-darkmode-dark">
                  Comprehensive overview and management of all quote requests and statistics.
                </p>
              </div>
              <div class="flex gap-4">
                <button 
                  id="managerLogoutButton"
                  class="rounded bg-red-600 px-4 py-3 text-white hover:bg-red-700"
                >
                  Logout
                </button>
              </div>
            </div>

            <!-- Manager Stats Overview -->
            <div class="grid gap-6 md:grid-cols-4 mb-8">
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-primary">Total Quotes</h3>
                <p class="text-3xl font-bold" id="managerTotalQuotes">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-green-600">Completed Today</h3>
                <p class="text-3xl font-bold text-green-600" id="managerCompletedToday">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-blue-600">Revenue This Month</h3>
                <p class="text-3xl font-bold text-blue-600" id="managerRevenue">-</p>
              </div>
              <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
                <h3 class="mb-2 text-h6 text-orange-600">Pending Reviews</h3>
                <p class="text-3xl font-bold text-orange-600" id="managerPending">-</p>
              </div>
            </div>

            <!-- All Quote Requests Table -->
            <div class="rounded-lg bg-theme-light p-6 shadow-lg dark:bg-darkmode-theme-light">
              <h3 class="mb-4 text-h5">All Quote Requests</h3>
              <div id="allQuoteRequestsTable">
                <p class="text-center text-dark dark:text-darkmode-dark py-8">Loading all quote requests...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Accept Package Modal (for reseller) -->
  <div id="acceptPackageModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-darkmode-theme-light rounded-lg p-8 max-w-md w-full mx-4">
      <h3 class="text-h5 mb-4">Accept Package</h3>
      <form id="acceptPackageForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-dark dark:text-darkmode-dark mb-2">
            Package Tracking ID
          </label>
          <input 
            type="text" 
            id="trackingId"
            name="trackingId"
            required
            class="w-full rounded-lg border border-border bg-body px-4 py-3 text-dark placeholder:text-dark/60 focus:border-primary focus:ring-0 dark:border-darkmode-border dark:bg-darkmode-body dark:text-darkmode-dark"
            placeholder="Enter tracking ID"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-dark dark:text-darkmode-dark mb-2">
            Customer Email
          </label>
          <input 
            type="email" 
            id="customerEmail"
            name="customerEmail"
            required
            class="w-full rounded-lg border border-border bg-body px-4 py-3 text-dark placeholder:text-dark/60 focus:border-primary focus:ring-0 dark:border-darkmode-border dark:bg-darkmode-body dark:text-darkmode-dark"
            placeholder="Customer's email address"
          />
        </div>
        <div class="flex gap-4 pt-4">
          <button 
            type="button"
            id="cancelAcceptance"
            class="flex-1 rounded bg-gray-500 px-4 py-2 text-white hover:bg-gray-600"
          >
            Cancel
          </button>
          <button 
            type="submit"
            class="flex-1 rounded bg-primary px-4 py-2 text-white hover:bg-primary/90"
          >
            Accept Package
          </button>
        </div>
      </form>
    </div>
  </div>
</Base>

<script>
  import { isAuthenticated, getCurrentUser, logout, pb } from '@/lib/utils/pocketbase';

  // Check if user is authenticated
  if (!isAuthenticated()) {
    window.location.href = '/login';
  }

  const user = getCurrentUser();
  if (!user) {
    window.location.href = '/login';
  }

  // Show appropriate dashboard based on role
  function showDashboard() {
    const loadingScreen = document.getElementById('loadingScreen');
    const userDashboard = document.getElementById('userDashboard');
    const resellerDashboard = document.getElementById('resellerDashboard');
    const managerDashboard = document.getElementById('managerDashboard');

    // Hide loading screen
    if (loadingScreen) loadingScreen.classList.add('hidden');

    const role = user.role || '';
    
    switch (role) {
      case 'manager':
        if (managerDashboard) managerDashboard.classList.remove('hidden');
        loadManagerDashboard();
        break;
      case 'reseller':
        if (resellerDashboard) resellerDashboard.classList.remove('hidden');
        loadResellerDashboard();
        break;
      default:
        // Regular user (empty role)
        if (userDashboard) userDashboard.classList.remove('hidden');
        loadUserDashboard();
        break;
    }
  }

  // Handle logout for all dashboards
  function setupLogoutHandlers() {
    const logoutButtons = ['logoutButton', 'resellerLogoutButton', 'managerLogoutButton'];
    
    logoutButtons.forEach(buttonId => {
      const button = document.getElementById(buttonId);
      if (button) {
        button.addEventListener('click', () => {
          logout();
          window.location.href = '/';
        });
      }
    });
  }

  // Load User Dashboard Data
  async function loadUserDashboard() {
    try {
      const records = await pb.collection('quote_requests').getList(1, 50, {
        filter: `sender_email = "${user.email}"`,
        sort: '-created',
      });

      const totalCount = records.totalItems;
      const completedCount = records.items.filter(item => item.completed).length;
      const pendingCount = totalCount - completedCount;

      // Update stats
      const totalEl = document.getElementById('totalRequests');
      const completedEl = document.getElementById('completedRequests');
      const pendingEl = document.getElementById('pendingRequests');

      if (totalEl) totalEl.textContent = totalCount.toString();
      if (completedEl) completedEl.textContent = completedCount.toString();
      if (pendingEl) pendingEl.textContent = pendingCount.toString();

      // Generate table
      const tableContainer = document.getElementById('quoteRequestsTable');
      
      if (records.items.length === 0) {
        if (tableContainer) {
          tableContainer.innerHTML = `
            <div class="text-center py-8">
              <p class="text-dark dark:text-darkmode-dark mb-4">No quote requests found.</p>
              <a href="/quote" class="inline-block rounded bg-primary px-6 py-3 text-white hover:bg-primary/90">
                Create Your First Quote Request
              </a>
            </div>
          `;
        }
        return;
      }

      let tableHTML = `
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border dark:border-darkmode-border">
                <th class="text-left py-3 px-4">Date</th>
                <th class="text-left py-3 px-4">Recipient</th>
                <th class="text-left py-3 px-4">Destination</th>
                <th class="text-left py-3 px-4">Weight</th>
                <th class="text-left py-3 px-4">Quote Price</th>
                <th class="text-left py-3 px-4">Status</th>
              </tr>
            </thead>
            <tbody>
      `;

      records.items.forEach(request => {
        const date = new Date(request.created).toLocaleDateString();
        const recipient = `${request.recipient_first_name || ''} ${request.recipient_last_name || ''}`.trim() || 'N/A';
        const destination = `${request.recipient_city || ''}, ${request.destination_country || ''}`.trim().replace(/^,\s*/, '') || 'N/A';
        const weight = request.weight_lbs ? `${request.weight_lbs} lbs` : 'N/A';
        const price = request.quote_price ? `$${request.quote_price}` : 'Pending';
        const status = request.completed ? 'Completed' : 'Pending';
        const statusClass = request.completed ? 'text-green-600' : 'text-orange-600';

        tableHTML += `
          <tr class="border-b border-border dark:border-darkmode-border hover:bg-theme-light/50">
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${date}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${recipient}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${destination}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${weight}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${price}</td>
            <td class="py-3 px-4 ${statusClass} font-medium">${status}</td>
          </tr>
        `;
      });

      tableHTML += `
            </tbody>
          </table>
        </div>
      `;

      if (tableContainer) tableContainer.innerHTML = tableHTML;

    } catch (error) {
      console.error('Error loading quote requests:', error);
      const tableContainer = document.getElementById('quoteRequestsTable');
      if (tableContainer) {
        tableContainer.innerHTML = `
          <div class="text-center py-8">
            <p class="text-red-600">Error loading quote requests. Please try again.</p>
          </div>
        `;
      }
    }
  }

  // Load Reseller Dashboard Data
  async function loadResellerDashboard() {
    // Setup modal handling
    const acceptPackageBtn = document.getElementById('acceptPackageBtn');
    const acceptPackageModal = document.getElementById('acceptPackageModal');
    const cancelAcceptance = document.getElementById('cancelAcceptance');
    const acceptPackageForm = document.getElementById('acceptPackageForm');

    acceptPackageBtn?.addEventListener('click', () => {
      acceptPackageModal?.classList.remove('hidden');
      acceptPackageModal?.classList.add('flex');
    });

    cancelAcceptance?.addEventListener('click', () => {
      acceptPackageModal?.classList.add('hidden');
      acceptPackageModal?.classList.remove('flex');
    });

    // Handle package acceptance form
    acceptPackageForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(acceptPackageForm as HTMLFormElement);
      const trackingId = formData.get('trackingId') as string;
      const customerEmail = formData.get('customerEmail') as string;

      try {
        alert(`Package ${trackingId} accepted for ${customerEmail}`);
        
        acceptPackageModal?.classList.add('hidden');
        acceptPackageModal?.classList.remove('flex');
        (acceptPackageForm as HTMLFormElement)?.reset();
        loadResellerData();
      } catch (error) {
        console.error('Error accepting package:', error);
        alert('Error accepting package. Please try again.');
      }
    });

    loadResellerData();
  }

  async function loadResellerData() {
    try {
      const quoteRequests = await pb.collection('quote_requests').getList(1, 100, {
        sort: '-created',
      });

      // Mock data for reseller stats
      const todayCount = Math.floor(Math.random() * 15) + 1;
      const monthlyCount = Math.floor(Math.random() * 200) + 50;
      const revenue = (monthlyCount * 25).toFixed(2);
      const pendingCount = quoteRequests.items.filter(item => !item.completed).length;

      // Update stats
      const todayEl = document.getElementById('todayPackages');
      const monthlyEl = document.getElementById('monthlyPackages');
      const revenueEl = document.getElementById('totalRevenue');
      const pendingEl = document.getElementById('pendingQuotes');

      if (todayEl) todayEl.textContent = todayCount.toString();
      if (monthlyEl) monthlyEl.textContent = monthlyCount.toString();
      if (revenueEl) revenueEl.textContent = `$${revenue}`;
      if (pendingEl) pendingEl.textContent = pendingCount.toString();

      // Generate mock charts
      generateResellerCharts();
      loadRecentPackages();

    } catch (error) {
      console.error('Error loading reseller data:', error);
    }
  }

  function generateResellerCharts() {
    // Monthly chart
    const monthlyChart = document.getElementById('monthlyChart');
    if (monthlyChart) {
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
      const values = [45, 62, 38, 71, 55, 89];
      
      let chartHTML = '<div class="flex items-end justify-between h-48 px-4">';
      values.forEach((value, index) => {
        const height = (value / Math.max(...values)) * 100;
        chartHTML += `
          <div class="flex flex-col items-center">
            <div class="bg-primary rounded-t" style="height: ${height}%; width: 30px; min-height: 10px;"></div>
            <span class="text-xs mt-2 text-dark dark:text-darkmode-dark">${months[index]}</span>
          </div>
        `;
      });
      chartHTML += '</div>';
      monthlyChart.innerHTML = chartHTML;
    }

    // Revenue chart
    const revenueChart = document.getElementById('revenueChart');
    if (revenueChart) {
      revenueChart.innerHTML = `
        <div class="flex items-center justify-center h-48">
          <div class="text-center">
            <div class="text-4xl font-bold text-green-600 mb-2">📈</div>
            <p class="text-dark dark:text-darkmode-dark">Revenue trending upward</p>
            <p class="text-sm text-green-600 mt-2">+23% from last month</p>
          </div>
        </div>
      `;
    }
  }

  function loadRecentPackages() {
    const recentPackages = document.getElementById('recentPackages');
    if (!recentPackages) return;

    const packages = [
      { id: 'PKG001', customer: 'John Doe', email: 'john@example.com', time: '2 hours ago', status: 'Accepted' },
      { id: 'PKG002', customer: 'Jane Smith', email: 'jane@example.com', time: '4 hours ago', status: 'Accepted' },
      { id: 'PKG003', customer: 'Bob Johnson', email: 'bob@example.com', time: '6 hours ago', status: 'Accepted' },
    ];

    let tableHTML = `
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-border dark:border-darkmode-border">
              <th class="text-left py-3 px-4">Package ID</th>
              <th class="text-left py-3 px-4">Customer</th>
              <th class="text-left py-3 px-4">Email</th>
              <th class="text-left py-3 px-4">Time</th>
              <th class="text-left py-3 px-4">Status</th>
            </tr>
          </thead>
          <tbody>
    `;

    packages.forEach(pkg => {
      tableHTML += `
        <tr class="border-b border-border dark:border-darkmode-border hover:bg-theme-light/50">
          <td class="py-3 px-4 text-dark dark:text-darkmode-dark font-medium">${pkg.id}</td>
          <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${pkg.customer}</td>
          <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${pkg.email}</td>
          <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${pkg.time}</td>
          <td class="py-3 px-4 text-green-600 font-medium">${pkg.status}</td>
        </tr>
      `;
    });

    tableHTML += `
          </tbody>
        </table>
      </div>
    `;

    recentPackages.innerHTML = tableHTML;
  }

  // Load Manager Dashboard Data
  async function loadManagerDashboard() {
    try {
      const allRequests = await pb.collection('quote_requests').getList(1, 100, {
        sort: '-created',
      });

      // Calculate manager stats
      const totalQuotes = allRequests.totalItems;
      const completedToday = allRequests.items.filter(item => 
        item.completed && new Date(item.updated).toDateString() === new Date().toDateString()
      ).length;
      const monthlyRevenue = allRequests.items
        .filter(item => item.quote_price && item.completed)
        .reduce((sum, item) => sum + (item.quote_price || 0), 0);
      const pendingCount = allRequests.items.filter(item => !item.completed).length;

      // Update manager stats
      const totalEl = document.getElementById('managerTotalQuotes');
      const completedEl = document.getElementById('managerCompletedToday');
      const revenueEl = document.getElementById('managerRevenue');
      const pendingEl = document.getElementById('managerPending');

      if (totalEl) totalEl.textContent = totalQuotes.toString();
      if (completedEl) completedEl.textContent = completedToday.toString();
      if (revenueEl) revenueEl.textContent = `$${monthlyRevenue.toFixed(2)}`;
      if (pendingEl) pendingEl.textContent = pendingCount.toString();

      // Generate all quotes table
      const tableContainer = document.getElementById('allQuoteRequestsTable');
      
      if (allRequests.items.length === 0) {
        if (tableContainer) {
          tableContainer.innerHTML = `
            <div class="text-center py-8">
              <p class="text-dark dark:text-darkmode-dark">No quote requests found.</p>
            </div>
          `;
        }
        return;
      }

      let tableHTML = `
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border dark:border-darkmode-border">
                <th class="text-left py-3 px-4">Date</th>
                <th class="text-left py-3 px-4">Sender</th>
                <th class="text-left py-3 px-4">Recipient</th>
                <th class="text-left py-3 px-4">Destination</th>
                <th class="text-left py-3 px-4">Weight</th>
                <th class="text-left py-3 px-4">Value</th>
                <th class="text-left py-3 px-4">Quote Price</th>
                <th class="text-left py-3 px-4">Status</th>
              </tr>
            </thead>
            <tbody>
      `;

      allRequests.items.forEach(request => {
        const date = new Date(request.created).toLocaleDateString();
        const sender = `${request.sender_first_name || ''} ${request.sender_last_name || ''}`.trim() || 'N/A';
        const recipient = `${request.recipient_first_name || ''} ${request.recipient_last_name || ''}`.trim() || 'N/A';
        const destination = `${request.recipient_city || ''}, ${request.destination_country || ''}`.trim().replace(/^,\s*/, '') || 'N/A';
        const weight = request.weight_lbs ? `${request.weight_lbs} lbs` : 'N/A';
        const value = request.declared_value_usd ? `$${request.declared_value_usd}` : 'N/A';
        const price = request.quote_price ? `$${request.quote_price}` : 'Pending';
        const status = request.completed ? 'Completed' : 'Pending';
        const statusClass = request.completed ? 'text-green-600' : 'text-orange-600';

        tableHTML += `
          <tr class="border-b border-border dark:border-darkmode-border hover:bg-theme-light/50">
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${date}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${sender}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${recipient}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${destination}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${weight}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${value}</td>
            <td class="py-3 px-4 text-dark dark:text-darkmode-dark">${price}</td>
            <td class="py-3 px-4 ${statusClass} font-medium">${status}</td>
          </tr>
        `;
      });

      tableHTML += `
            </tbody>
          </table>
        </div>
      `;

      if (tableContainer) tableContainer.innerHTML = tableHTML;

    } catch (error) {
      console.error('Error loading manager dashboard:', error);
      const tableContainer = document.getElementById('allQuoteRequestsTable');
      if (tableContainer) {
        tableContainer.innerHTML = `
          <div class="text-center py-8">
            <p class="text-red-600">Error loading quote requests. Please try again.</p>
          </div>
        `;
      }
    }
  }

  // Initialize dashboard
  document.addEventListener('DOMContentLoaded', () => {
    setupLogoutHandlers();
    showDashboard();
  });
</script>